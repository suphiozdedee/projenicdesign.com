# ── PROJENIC DESIGN SYSTEM & HOSTINGER APACHE CONFIG ─────────────────
# Güvenlik, HTTPS yönlendirmesi, önbellekleme ve sıkıştırma kuralları

# HTTP/3 (QUIC) önerisi kapalı: Hostinger CDN'de QUIC bağlantısı takılıp sayfa dosyalarını yüklemiyordu.
# Tarayıcılar HTTP/2 ile bağlanır.
<IfModule mod_headers.c>
  Header always unset Alt-Svc
  Header unset Alt-Svc
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Tek alan adı: www → projenicdesign.com (yinelenen içerik önlenir)
  RewriteCond %{HTTP_HOST} ^www\.projenicdesign\.com$ [NC]
  RewriteRule ^(.*)$ https://projenicdesign.com/$1 [R=301,L]

  # 3. /index.html → / (yalnızca tarayıcı isteğinde; iç yönlendirmede döngü olmaz)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://projenicdesign.com/ [R=301,L]

  # 4. Yayından kaldırılan eski vaka sayfası proje listesine yönlenir
  RewriteRule ^proje-aurora\.html$ https://projenicdesign.com/projeler.html [R=301,L]
</IfModule>

# ── 2. Güvenlik Başlıkları ─────────────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── 3. Tarayıcı Önbellekleme (Browser Caching) ────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML - Kısa süre (güncel içerik için)
  ExpiresByType text/html "access plus 0 seconds"

  # CSS, JavaScript
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Görseller & Fontlar
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# ── 4. GZIP Sıkıştırma (LiteSpeed / Apache) ───────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Özel 404 sayfası ──────────────────────────────────────────────────
ErrorDocument 404 /404.html

# ── 5. Karakter Kodlaması ─────────────────────────────────────────────
AddDefaultCharset UTF-8
